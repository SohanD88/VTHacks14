SPATIAL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5177","http://127.0.0.1:5177"]
SPATIAL_LOG_LEVEL=INFO
SPATIAL_MAX_STORED_SCANS=20
SPATIAL_MAX_UPLOAD_BYTES=262144000
SPATIAL_MAX_STORAGE_BYTES=2147483648
SPATIAL_DETECTION_CONFIDENCE=0.5
# Optional absolute overrides (defaults: repository/.model-cache and .spatial-data)
# SPATIAL_MODEL_CACHE=/absolute/path/to/model-cache
# SPATIAL_DATA_DIR=/absolute/path/to/scan-data

# Blender model import and structured room generation
SPATIAL_BLENDER_TRANSPORT=headless
SPATIAL_BLENDER_BINARY=blender
SPATIAL_BLENDER_TIMEOUT_SECONDS=300
# Optional official Blender MCP transport (Python needs the mcp package)
# SPATIAL_BLENDER_TRANSPORT=mcp
# SPATIAL_BLENDER_MCP_COMMAND=/absolute/path/to/blender-mcp
# SPATIAL_BLENDER_MCP_PYTHON=/absolute/path/to/python
# Gemini video generation (matches the furnished-room experiment)
SPATIAL_BLENDER_PROVIDER=gemini
SPATIAL_BLENDER_PLANNER_MODEL=gemini-3.6-flash
# Set GEMINI_API_KEY / GOOGLE_API_KEY in the server environment, or:
# SPATIAL_BLENDER_API_KEY=
# Optional explicit macOS Keychain service used by the experiment:
# SPATIAL_GEMINI_KEYCHAIN_SERVICE=vt-hacks-gemini-api
# Optional older data-only room-plan provider:
# SPATIAL_BLENDER_PROVIDER=openai
# SPATIAL_BLENDER_API_BASE=https://api.openai.com/v1

# Compare generated views with source frames; at most one visual correction.
SPATIAL_BLENDER_VISUAL_REVIEW=true
