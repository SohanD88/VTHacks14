SPATIAL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SPATIAL_LOG_LEVEL=INFO
SPATIAL_MAX_STORED_SCANS=100

# RF-DETR Nano live camera confidence cutoff (same default as SDObjectDetection)
SPATIAL_DETECTION_CONFIDENCE=0.5
# Optional override; defaults to the repository .model-cache
# SPATIAL_MODEL_CACHE=/absolute/path/to/model-cache
